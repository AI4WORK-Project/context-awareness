        <rdfs:subClassOf rdf:resource="http://www.atb-bremen.de/ontologies/generic-context-model/Activity"/>
        <skos:definition>Prediction is an Activity of foreseen attitudes in the operation of a system (machine, product or process) in order to (re)act accordingly in its future operation.</skos:definition>
    </owl:Class>
    


