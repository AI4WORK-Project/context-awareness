        <owl:disjointWith rdf:resource="http://www.atb-bremen.de/ontologies/generic-context-model/VolumeSensor"/>
        <skos:definition>Pressure Sensor is a Sensorial Device that collects pressure information from the area of operation.</skos:definition>
