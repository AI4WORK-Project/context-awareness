                <owl:someValuesFrom rdf:resource="http://www.atb-bremen.de/ontologies/generic-context-model/WorkProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition>Subprocess is a process of limited duration or scope, or which includes less actions than a process. A process step can itself be a process.</skos:definition>
    </owl:Class>
    


    <!-- http://www.atb-bremen.de/ontologies/generic-context-model/ProcessingDevice -->

