        <rdfs:subClassOf rdf:resource="http://www.atb-bremen.de/ontologies/generic-context-model/Actor"/>
        <skos:definition>Actor is an entity that describes the humans involved in the situations observed by the  solution.</skos:definition>
    </owl:Class>
    


    <!-- http://www.atb-bremen.de/ontologies/generic-context-model/Optimisation -->

    <owl:Class rdf:about="http://www.atb-bremen.de/ontologies/generic-context-model/Optimisation">
        <rdfs:subClassOf rdf:resource="http://www.atb-bremen.de/ontologies/generic-context-model/Activity"/>
        <skos:definition>Optimisation is an Activity of improving the operation of a system, by adjusting its (operation) parameters to more effective values.</skos:definition>
    </owl:Class>
    


    <!-- http://www.atb-bremen.de/ontologies/generic-context-model/Paint -->

    <owl:Class rdf:about="http://www.atb-bremen.de/ontologies/generic-context-model/Paint">
